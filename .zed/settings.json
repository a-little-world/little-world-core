{
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "tmux",
        "args": ["new-session", "-A", "-s", "zed-little-world"]
      }
    },
    "detect_venv": {
      "on": {
        "directories": ["venv"],
        "activate_script": "default"
      }
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "venvPath": ".",
          "venv": "venv",
          "analysis": {
            "extraPaths": [
              "./back"
            ]
          }
        }
      }
    }
  }
}
